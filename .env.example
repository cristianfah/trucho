# Conexión a Postgres (Supabase: Settings → Database → Connection string, modo session)
# Requiere PostgreSQL 16+ con la extensión pgvector disponible.
DATABASE_URL=postgresql://postgres:password@localhost:5432/trucho

# API key de Anthropic — solo la usa el pipeline de enrichment (trucho enrich).
# El servidor MCP nunca la necesita.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo para enrichment (opcional, default: claude-sonnet-5)
# TRUCHO_ENRICH_MODEL=claude-sonnet-5

# User-Agent del scraper (opcional; mantener identificable con link al repo)
# TRUCHO_USER_AGENT=trucho-bot/0.1 (+https://github.com/cristianfah/trucho)
